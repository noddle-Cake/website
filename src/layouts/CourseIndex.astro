---
import Layout from './Layout.astro';
import { getCourse } from '../data/courses/registry';
import { lessonSlugs } from '../data/courses/types';

interface Props {
  course: string;
}

const { slug, title, topic, tagline, units } = getCourse(Astro.props.course);
const totalLessons = lessonSlugs(getCourse(Astro.props.course)).length;
---

<Layout title={title}>
  <section class="py-8">
    <nav data-reveal class="text-xs font-mono text-slate-500 flex items-center gap-2 mb-4">
      <a href="/courses" class="hover:text-slate-100 transition-colors">Courses</a>
      <span>/</span>
      <span>{topic}</span>
    </nav>
    <p data-reveal class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500">{topic}</p>
    <h1
      data-reveal
      class="mt-3 font-extrabold tracking-tight leading-[0.95] text-[clamp(2rem,5.5vw,3.5rem)]"
    >
      {title}
    </h1>
    <p data-reveal class="mt-4 max-w-2xl text-slate-400 leading-relaxed">{tagline}</p>

    <slot name="intro" />

    <div data-reveal class="mt-6 flex items-center gap-3 max-w-md">
      <div class="flex-1 h-1.5 rounded-full bg-slate-800 overflow-hidden">
        <div
          id="course-progress-bar"
          class="h-full bg-slate-100 transition-all duration-500"
          style="width: 0%"
        >
        </div>
      </div>
      <span id="course-progress-label" class="text-xs font-mono text-slate-500 shrink-0"
        >0 / {totalLessons}</span
      >
    </div>
    <div id="course-progress-data" data-course={slug} data-total={totalLessons} hidden></div>
  </section>

  <section class="py-8 border-t border-slate-800 space-y-10">
    {
      units.map((unit, unitIndex) => (
        <div>
          <div data-reveal class="flex items-baseline justify-between mb-4">
            <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500">
              Unit {unitIndex + 1} &middot; {unit.title}
            </h2>
          </div>
          <ol class="space-y-3">
            {unit.lessons.map((lesson, lessonIndex) => (
              <li data-reveal>
                <a
                  href={`/courses/${slug}/${lesson.slug}`}
                  class="group flex items-start gap-4 border border-slate-800 rounded-lg p-4 transition-all duration-300 hover:border-slate-500 hover:-translate-y-0.5 hover:shadow-lg"
                >
                  <span
                    data-lesson-marker
                    data-lesson-slug={lesson.slug}
                    class="mt-0.5 shrink-0 w-6 h-6 rounded-full border border-slate-700 flex items-center justify-center text-[11px] font-mono text-slate-500 group-hover:border-slate-500"
                  >
                    {lessonIndex + 1}
                  </span>
                  <span class="flex-1">
                    <span class="block font-semibold text-slate-100 group-hover:text-slate-50 transition-colors">
                      {lesson.title}
                    </span>
                    <span class="block text-sm text-slate-400 mt-1 leading-relaxed">
                      {lesson.summary}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </section>

  <slot name="outro" />

  <script>
    import { isLessonComplete } from '../scripts/courses/progress';

    const dataEl = document.getElementById('course-progress-data');
    const courseSlug = dataEl?.dataset.course ?? '';
    const totalLessons = Number(dataEl?.dataset.total ?? 0);

    const markers = document.querySelectorAll<HTMLElement>('[data-lesson-marker]');
    let done = 0;
    markers.forEach((marker) => {
      const lessonSlug = marker.dataset.lessonSlug;
      if (lessonSlug && isLessonComplete(courseSlug, lessonSlug)) {
        done += 1;
        marker.textContent = '✓';
        marker.classList.add('!border-slate-400', '!text-slate-100', 'bg-slate-800');
      }
    });
    const bar = document.getElementById('course-progress-bar');
    const label = document.getElementById('course-progress-label');
    if (bar) bar.style.width = `${totalLessons ? (done / totalLessons) * 100 : 0}%`;
    if (label) label.textContent = `${done} / ${totalLessons}`;
  </script>
</Layout>
