---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Projects">
  <section id="projects" data-section="Projects" class="section section--first">
    <h1 class="section-title">Projects. <span>All {allProjects.length} of them.</span></h1>
    <div class="card-grid">
      {allProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</Layout>
