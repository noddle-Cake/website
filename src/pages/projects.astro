---
import Layout from '../layouts/Layout.astro';
import ProjectItem from '../components/ProjectItem.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout title="Projects">
  <section id="projects" data-section="Projects" class="split-section">
    <div class="split-heading-wrap">
      <h1 data-reveal class="split-heading">Everything I&rsquo;ve built</h1>
      <p data-reveal class="meta-row-label mt-6">{allProjects.length} projects</p>
    </div>
    <div class="split-body">
      {
        allProjects.map((project) => (
          <ProjectItem
            id={project.id}
            title={project.data.title}
            stack={project.data.stack}
            summary={project.data.summary}
            github={project.data.github}
            demo={project.data.demo}
          />
        ))
      }
    </div>
  </section>
</Layout>
