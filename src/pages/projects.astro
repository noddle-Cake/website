---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout title="Projects">
  <section class="py-8">
    <p data-reveal class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500">
      All work
    </p>
    <h1 data-reveal class="mt-3 font-extrabold tracking-tight leading-[0.95] text-[clamp(2.25rem,6vw,4rem)]">
      Projects
    </h1>
  </section>

  <section class="py-8 border-t border-slate-800">
    <div class="grid sm:grid-cols-2 gap-4">
      {allProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          stack={project.data.stack}
          summary={project.data.summary}
          github={project.data.github}
          demo={project.data.demo}
        />
      ))}
    </div>
  </section>
</Layout>
