---
import Layout from '../layouts/Layout.astro';
import ProjectItem from '../components/ProjectItem.astro';
import Row from '../components/Row.astro';
import gridmergePrint from '../assets/gallery/gridmerge.webp';
import oncoraPrint from '../assets/gallery/oncora.webp';
import vasPrint from '../assets/gallery/vas.webp';
import { profile } from '../data/profile';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter((p: CollectionEntry<'projects'>) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
// Every project with a demo appears in the hero, labelled with its code and linking to the demo.
const prints: Record<string, { image: ImageMetadata; alt: string }> = {
  gridmerge: { image: gridmergePrint, alt: 'GridMerge map of planned U.S. grid projects, colored by utility' },
  oncora: { image: oncoraPrint, alt: 'Oncora compound input, with the steps from structure to targets, cell lines and evidence' },
  'vas-inventory-platform': { image: vasPrint, alt: 'VAS dashboard of purchase orders received but not yet reconciled' },
};
const exhibits = allProjects
  .filter((p: CollectionEntry<'projects'>) => p.data.demo)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p: CollectionEntry<'projects'>) => {
    const print = prints[p.id];
    if (!print) throw new Error(`Project "${p.id}" has a demo but no hero image in index.astro`);
    return { code: p.data.code, href: p.data.demo, ...print };
  });

const skills = [...profile.skills.languages, ...profile.skills.frameworks, ...profile.skills.systems];
---

<Layout>
  <section id="top" data-section="Home" class="hero">
    <div class="hero-grid">
      <div>
        <h1 class="hero-title">
          <span class="block">Engineer.</span>
          <span class="block">Builder.</span>
          <span class="block">Signal&nbsp;chaser.</span>
        </h1>
        <p class="lead">{profile.tagline}</p>
      </div>
      <div class="hero-art">
        {
          exhibits.map((e) => (
            <a
              href={e.href}
              target={e.href.startsWith('http') ? '_blank' : undefined}
              rel={e.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="print"
            >
              <img src={e.image.src} width={e.image.width} height={e.image.height} alt={e.alt} decoding="async" />
              <span class="print-code">{e.code}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section id="about" data-section="About" class="split-section">
    <h2 class="split-heading">About</h2>
    <div class="split-body">
      <Row title={profile.company.name}>
        <p>{profile.company.blurb}</p>
        <p class="row-links">
          <a href={profile.company.url} target="_blank" rel="noopener noreferrer" class="text-link">Visit</a>
        </p>
      </Row>
      {
        profile.education.map((ed) => (
          <Row title={ed.degree.split(',')[0]} meta={ed.date}>
            <p>{ed.degree}</p>
            <p class="row-note">{ed.school}</p>
          </Row>
        ))
      }
      <Row title="Skills">
        <p>{skills.join(', ')}</p>
      </Row>
    </div>
  </section>

  <section id="experience" data-section="Experience" class="split-section">
    <h2 class="split-heading">Experience</h2>
    <div class="split-body">
      {
        profile.experience.map((job) => (
          <Row title={job.org} meta={job.date}>
            <p>{job.role}</p>
            <ul class="row-list">
              {job.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          </Row>
        ))
      }
    </div>
  </section>

  <section id="projects" data-section="Work" class="split-section">
    <h2 class="split-heading">Work</h2>
    <div class="split-body">
      {
        featured.map((project: CollectionEntry<'projects'>) => (
          <ProjectItem
            id={project.id}
            code={project.data.code}
            title={project.data.title}
            stack={project.data.stack}
            summary={project.data.summary}
            github={project.data.github}
            demo={project.data.demo}
            caseStudy={project.data.caseStudy}
          />
        ))
      }
      <p class="row-links"><a href="/projects" class="text-link">All {allProjects.length} projects</a></p>
    </div>
  </section>
</Layout>
