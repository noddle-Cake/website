---
import Layout from '../layouts/Layout.astro';
import ShowcaseTile from '../components/ShowcaseTile.astro';
import Row from '../components/Row.astro';
import { profile } from '../data/profile';
import { projectMedia } from '../data/projectMedia';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featured = allProjects.filter((p) => p.data.featured).sort((a, b) => a.data.order - b.data.order);
// The lead project gets the full-width dark tile; after it, a project with a screenshot takes half
// a row and one without takes a third. Half tiles pair like with like, a phone beside a phone and a
// window beside a window, so neither is stretched to its neighbour's height (order the projects so
// pairs sit next to each other). With an odd number of either kind, the last of that kind spans the
// row instead.
const withShot = featured.slice(1).filter((p) => projectMedia[p.id]);
const alone = new Set(
  [true, false].flatMap((phone) => {
    const kind = withShot.filter((p) => !!projectMedia[p.id].phone === phone);
    return kind.length % 2 === 1 ? [kind.at(-1)!.id] : [];
  }),
);
const tileSize = (id: string, index: number) =>
  index === 0 || alone.has(id) ? 'wide' : projectMedia[id] ? 'half' : 'third';

const skillGroups = [
  { label: 'Languages', items: profile.skills.languages },
  { label: 'Frameworks and tools', items: profile.skills.frameworks },
  { label: 'Systems', items: profile.skills.systems },
];
---

<Layout>
  <section id="top" data-section="Home" class="hero">
    <h1 class="hero-title">Engineer. Builder. <span>Signal&nbsp;chaser.</span></h1>
    <p class="hero-lead">{profile.tagline}</p>
    <p class="hero-actions">
      <a href="#projects" class="btn">See the work</a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="chev-link">Get in touch</a>
    </p>
  </section>

  <section id="projects" data-section="Work" class="section">
    <h2 class="section-title">Work. <span>Built, shipped and in use.</span></h2>
    <div class="tile-grid">
      {featured.map((project, i) => <ShowcaseTile project={project} size={tileSize(project.id, i)} dark={i === 0} />)}
    </div>
    <p class="section-more">
      <a href="/projects" class="chev-link">See all {allProjects.length} projects</a>
    </p>
  </section>

  <section id="about" data-section="About" class="section">
    <h2 class="section-title">About. <span>Software, hardware and the operations in between.</span></h2>
    <div class="bento">
      <article class="panel reveal">
        <p class="panel-eyebrow">Practice</p>
        <h3 class="panel-title">{profile.company.name}</h3>
        <p class="panel-text">{profile.company.blurb}</p>
        <p class="chev-links">
          <a href={profile.company.url} target="_blank" rel="noopener noreferrer" class="chev-link">Visit</a>
        </p>
      </article>
      {
        profile.education.map((ed) => (
          <article class="panel reveal">
            <p class="panel-eyebrow">{ed.date}</p>
            <h3 class="panel-title">{ed.degree.split(',')[0]}</h3>
            <p class="panel-text">
              {ed.degree.split(', ')[1] && <>{ed.degree.split(', ')[1]}<br /></>}
              {ed.school}
            </p>
          </article>
        ))
      }
      <article class="panel panel--full reveal">
        <p class="panel-eyebrow">Skills</p>
        <div class="skill-groups">
          {
            skillGroups.map((group) => (
              <div>
                <h3 class="skill-label">{group.label}</h3>
                <ul class="chips">
                  {group.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))
          }
        </div>
      </article>
    </div>
  </section>

  <section id="experience" data-section="Experience" class="section">
    <h2 class="section-title">Experience. <span>Where the work happened.</span></h2>
    <div class="rows">
      {
        profile.experience.map((job, i) => (
          <Row title={job.org} subtitle={job.role} meta={job.date} open={i === 0}>
            <ul class="row-list">
              {job.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          </Row>
        ))
      }
    </div>
  </section>

  <section id="contact" data-section="Contact" class="section contact">
    <h2 class="contact-title">Get in touch.</h2>
    <p class="hero-actions">
      <a href={`mailto:${profile.email}`} class="btn">Email me</a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="chev-link">LinkedIn</a>
    </p>
  </section>
</Layout>
