---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';
import { getCollection, type CollectionEntry } from 'astro:content';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter((p: CollectionEntry<'projects'>) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const allSkills = [...profile.skills.languages, ...profile.skills.frameworks, ...profile.skills.systems];
---

<Layout>
  <section class="min-h-[70vh] flex flex-col justify-center py-12">
    <p data-reveal class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500">
      {profile.name}<span class="signal-cursor signal-only">_</span>
    </p>
    <h1 class="mt-4 font-extrabold tracking-tight leading-[0.95] text-[clamp(2.75rem,9vw,6.5rem)]">
      <span data-reveal class="block">Engineer.</span>
      <span data-reveal class="block">Builder.</span>
      <span data-reveal class="block text-slate-400">Signal&nbsp;chaser.</span>
    </h1>
    <p data-reveal class="text-slate-400 mt-6 leading-relaxed max-w-2xl text-base sm:text-lg">
      {profile.tagline}
    </p>
    <div data-reveal class="flex flex-wrap gap-4 mt-8">
      <a
        href={`mailto:${profile.email}`}
        class="text-sm bg-slate-100 text-slate-900 rounded px-5 py-2.5 font-medium hover:bg-slate-300 transition-colors"
      >
        Get in touch
      </a>
      <a
        href="/projects"
        class="text-sm border border-slate-700 rounded px-5 py-2.5 font-medium hover:border-slate-500 transition-colors"
      >
        View all projects
      </a>
    </div>

    <svg
      class="signal-only mt-12 w-full max-w-md h-16 text-slate-300"
      viewBox="0 0 400 80"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M0 40 L40 40 L55 10 L70 70 L85 40 L120 40 L135 20 L150 60 L165 40 L400 40"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        pathLength="1000"
        stroke-dasharray="1000"
        stroke-dashoffset="1000"
        style="animation: trace-draw 2.5s ease-in-out infinite alternate;"
      ></path>
    </svg>

    <div data-reveal class="mt-16 font-mono text-xs text-slate-600 flex items-center gap-2">
      <span class="inline-block animate-bounce">&darr;</span>
      Scroll
    </div>
  </section>

  <section id="about" class="py-16 border-t border-slate-800 grid sm:grid-cols-[auto_1fr] gap-8 sm:gap-16">
    <h2 data-reveal class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500 sm:pt-1">
      01 / About
    </h2>
    <div>
      <div class="space-y-4 max-w-2xl">
        {profile.education.map((ed) => (
          <div data-reveal class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <span class="text-slate-100 font-medium">{ed.degree}</span>
            <span class="text-slate-500 text-sm font-mono shrink-0">{ed.school} &middot; {ed.date}</span>
          </div>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap gap-2">
        {allSkills.map((skill) => (
          <span
            data-reveal
            class="text-xs bg-slate-800 text-slate-300 rounded px-2 py-1 hover:bg-slate-700 hover:text-slate-100 transition-colors"
          >
            {skill}
          </span>
        ))}
      </div>
    </div>
  </section>

  <section id="projects" class="py-16 border-t border-slate-800 grid sm:grid-cols-[auto_1fr] gap-8 sm:gap-16">
    <h2 data-reveal class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500 sm:pt-1">
      02 / Projects
    </h2>
    <div class="grid sm:grid-cols-2 gap-4">
      {featured.map((project: CollectionEntry<'projects'>) => (
        <ProjectCard
          title={project.data.title}
          stack={project.data.stack}
          summary={project.data.summary}
          github={project.data.github}
          demo={project.data.demo}
        />
      ))}
    </div>
  </section>
</Layout>
