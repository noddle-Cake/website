---
import Layout from '../layouts/Layout.astro';
import ProjectItem from '../components/ProjectItem.astro';
import SurrealEye from '../components/SurrealEye.astro';
import { profile } from '../data/profile';
import { getCollection, type CollectionEntry } from 'astro:content';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter((p: CollectionEntry<'projects'>) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const toolkit = [
  { label: 'Languages', items: profile.skills.languages },
  { label: 'Frameworks & tools', items: profile.skills.frameworks },
  { label: 'Systems', items: profile.skills.systems },
];
---

<Layout>
  <section id="top" data-section="Home" class="hero">
    <div class="hero-grid">
      <div>
        <h1 class="hero-title">
          <span data-reveal class="block">Engineer.</span>
          <span data-reveal class="block">Builder.</span>
          <span data-reveal class="block italic text-accent"><span class="melt">Signal&nbsp;chaser.</span></span>
        </h1>
        <p data-reveal class="lead mt-8 max-w-xl">{profile.tagline}</p>
        <div data-reveal class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href={`mailto:${profile.email}`} class="ink-button">Get in touch &rarr;</a>
          <a href="#projects" class="arrow-link">See my work &rarr;</a>
        </div>
      </div>
      <div data-reveal class="hero-eye">
        <SurrealEye />
      </div>
    </div>
    <div data-reveal class="meta-row mt-16">
      <span>Embedded &middot; Automation &middot; Web</span>
      <span>Florida International University</span>
    </div>
  </section>

  <section id="about" data-section="About" class="split-section">
    <h2 data-reveal class="split-heading">Who I&nbsp;am</h2>
    <div class="split-body">
      <dl class="spec-list">
        <div data-reveal>
          <dt>Company</dt>
          <dd>
            <a href={profile.company.url} target="_blank" rel="noopener noreferrer" class="arrow-link">
              {profile.company.name} &nearr;
            </a>
            <span class="block text-slate-400">{profile.company.blurb}</span>
          </dd>
        </div>
        {
          profile.education.map((ed) => (
            <div data-reveal>
              <dt>{ed.date}</dt>
              <dd>
                <span class="text-slate-50">{ed.degree}</span>
                <span class="block text-slate-400">{ed.school}</span>
              </dd>
            </div>
          ))
        }
        {
          toolkit.map((group) => (
            <div data-reveal>
              <dt>{group.label}</dt>
              <dd>{group.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="experience" data-section="Experience" class="split-section">
    <h2 data-reveal class="split-heading">Where I&rsquo;ve worked</h2>
    <div class="split-body">
      {
        profile.experience.map((job) => (
          <article data-reveal class="entry">
            <h3 class="entry-title">{job.org}</h3>
            <p class="entry-sub">
              {job.role} <span class="text-slate-500">&middot; {job.date}</span>
            </p>
            <ul class="entry-list">
              {job.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section id="projects" data-section="Work" class="split-section">
    <div class="split-heading-wrap">
      <h2 data-reveal class="split-heading">What I&rsquo;ve built</h2>
      <a data-reveal href="/projects" class="arrow-link mt-6 hidden lg:inline-block">All {allProjects.length} projects &rarr;</a>
    </div>
    <div class="split-body">
      {
        featured.map((project: CollectionEntry<'projects'>) => (
          <ProjectItem
            id={project.id}
            title={project.data.title}
            stack={project.data.stack}
            summary={project.data.summary}
            github={project.data.github}
            demo={project.data.demo}
          />
        ))
      }
      <a href="/projects" class="arrow-link mt-10 inline-block lg:hidden">All {allProjects.length} projects &rarr;</a>
    </div>
  </section>
</Layout>
