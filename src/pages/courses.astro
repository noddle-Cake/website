---
import Layout from '../layouts/Layout.astro';
import CourseCard from '../components/CourseCard.astro';
import { getCollection } from 'astro:content';

const allCourses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);

const topics = new Map<string, typeof allCourses>();
for (const course of allCourses) {
  const list = topics.get(course.data.topic) ?? [];
  list.push(course);
  topics.set(course.data.topic, list);
}
---

<Layout title="Courses">
  <section class="py-8">
    <p data-reveal class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500">
      Learning
    </p>
    <h1 data-reveal class="mt-3 font-extrabold tracking-tight leading-[0.95] text-[clamp(2.25rem,6vw,4rem)]">
      Courses
    </h1>
    <p data-reveal class="mt-4 max-w-2xl text-slate-400 leading-relaxed">
      Interactive courses built from my own lecture notes, one per major topic rather than per
      class &mdash; an Image Processing course lives under a Computer Vision umbrella, for
      example. Built with Claude Code as a way to review and deepen what I learn in school, and
      open for anyone else to use.
    </p>
  </section>

  <section class="py-8 border-t border-slate-800">
    {
      topics.size === 0 ? (
        <div data-reveal class="border border-dashed border-slate-800 rounded-lg p-8 text-center">
          <p class="font-semibold text-slate-100">Nothing published yet</p>
          <p class="mt-2 text-sm text-slate-400 max-w-md mx-auto leading-relaxed">
            Courses are grouped by topic and built as I take the underlying classes. Check back
            soon for the first one.
          </p>
        </div>
      ) : (
        <div class="space-y-10">
          {[...topics.entries()].map(([topic, courses]) => (
            <div>
              <h2 data-reveal class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500 mb-4">
                {topic}
              </h2>
              <div class="grid sm:grid-cols-2 gap-4">
                {courses.map((course) => (
                  <CourseCard
                    title={course.data.title}
                    summary={course.data.summary}
                    status={course.data.status}
                    href={course.data.href}
                  />
                ))}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </section>
</Layout>
