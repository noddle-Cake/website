---
import Row from './Row.astro';

interface Props {
  id: string;
  code: string;
  title: string;
  stack: string[];
  summary: string;
  github?: string;
  demo?: string;
  caseStudy?: string;
}

const { id, code, title, stack, summary, github, demo, caseStudy } = Astro.props;
// Demos on other sites open in a new tab; on-site demos stay in this one.
const demoIsExternal = demo?.startsWith('http');
---

<Row id={`project-${id}`} code={code} title={title.split(' — ')[0]}>
  <p>{summary}</p>
  <p class="row-note">{stack.join(', ')}</p>
  {
    (demo || caseStudy || github) && (
      <p class="row-links">
        {demo && (
          <a
            href={demo}
            target={demoIsExternal ? '_blank' : undefined}
            rel={demoIsExternal ? 'noopener noreferrer' : undefined}
            class="text-link"
          >
            Demo
          </a>
        )}
        {caseStudy && (
          <a href={caseStudy} class="text-link">
            Before &amp; After
          </a>
        )}
        {github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="text-link">
            GitHub
          </a>
        )}
      </p>
    )
  }
</Row>
