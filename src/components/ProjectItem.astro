---
interface Props {
  id: string;
  title: string;
  stack: string[];
  summary: string;
  github?: string;
  demo?: string;
}

const { id, title, stack, summary, github, demo } = Astro.props;
// Demos on other sites open in a new tab; on-site demos (e.g. /vas-demo) stay in this one.
const demoIsExternal = demo?.startsWith('http');
---

<article id={`project-${id}`} data-reveal class="entry">
  <h3 class="entry-title">{title}</h3>
  <p class="entry-text">{summary}</p>
  <p class="entry-meta">{stack.join(' · ')}</p>
  {
    (demo || github) && (
      <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        {demo && (
          <a
            href={demo}
            target={demoIsExternal ? '_blank' : undefined}
            rel={demoIsExternal ? 'noopener noreferrer' : undefined}
            class="arrow-link text-accent"
          >
            Live demo &rarr;
          </a>
        )}
        {github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="arrow-link">
            GitHub &rarr;
          </a>
        )}
      </div>
    )
  }
</article>
