---
// A floating eye after Dalí's dream sequence for "Spellbound": a sculpted lump of flesh with a
// heavy lid, a dark iris catching a crescent of light, and drips hanging off its underside.
// The iris follows the pointer, the lid occasionally blinks, and in the lucid look it casts a
// shadow on the ground below. Sized in em, so it scales with the heading it sits in. Colors come
// from the palette. Purely decorative.
---

<svg class="surreal-eye hide-in-signal" viewBox="0 0 200 190" aria-hidden="true" focusable="false" data-surreal-eye>
  <defs>
    <!-- Lit from the upper left, like the painting: a pale rim fading into a cold shadow. -->
    <radialGradient id="surreal-eye-flesh" cx="32%" cy="22%" r="85%">
      <stop offset="0" style="stop-color: var(--dream-flesh-light)"></stop>
      <stop offset="0.5" style="stop-color: var(--dream-flesh)"></stop>
      <stop offset="1" style="stop-color: var(--dream-flesh-dark)"></stop>
    </radialGradient>
    <!-- The heavy lid's shadow falling across the white of the eye. -->
    <linearGradient id="surreal-eye-lid-shadow" x1="0" y1="0" x2="0.15" y2="1">
      <stop offset="0" style="stop-color: var(--dream-flesh-dark)" stop-opacity="0.85"></stop>
      <stop offset="0.6" style="stop-color: var(--dream-flesh-dark)" stop-opacity="0"></stop>
    </linearGradient>
    <radialGradient id="surreal-eye-iris" cx="50%" cy="50%" r="50%">
      <stop offset="0.35" style="stop-color: var(--dream-pupil)"></stop>
      <stop offset="0.82" style="stop-color: var(--dream-iris-ring)"></stop>
      <stop offset="1" style="stop-color: var(--dream-pupil)"></stop>
    </radialGradient>
    <radialGradient id="surreal-eye-shadow">
      <stop offset="0" style="stop-color: var(--dream-pupil)" stop-opacity="0.45"></stop>
      <stop offset="1" style="stop-color: var(--dream-pupil)" stop-opacity="0"></stop>
    </radialGradient>
    <clipPath id="surreal-eye-opening">
      <path d="M22 110 C 30 62, 112 46, 170 90 C 148 116, 70 128, 22 110 Z"></path>
    </clipPath>
  </defs>

  <!-- Its shadow on the ground, far below and off to one side (shown only in the lucid look). -->
  <ellipse class="eye-shadow" cx="146" cy="182" rx="44" ry="6" style="fill: url(#surreal-eye-shadow)"></ellipse>

  <g class="eye-body">
    <!-- Drips, hanging from the underside; drawn first so the body overlaps their tops. -->
    <g class="eye-drips" style="fill: var(--dream-flesh-dark)">
      <path d="M34 116 C 36 122, 42.6 129, 41.0 137 a 3.4 3.4 0 1 0 6.0 0 C 45.4 129, 50 122, 52 116 Z"></path>
      <path d="M54 119 C 56 125, 59.6 149, 58.199999999999996 157 a 3.2 3.2 0 1 0 5.6 0 C 62.4 149, 68 125, 70 119 Z"></path>
      <path d="M72 120 C 74 126, 76.6 123, 75.80000000000001 131 a 2.6 2.6 0 1 0 4.4 0 C 79.4 123, 82 126, 84 120 Z"></path>
      <path d="M86 120 C 88 126, 93.6 159, 91.60000000000001 167 a 3.8 3.8 0 1 0 6.8 0 C 96.4 159, 104 126, 106 120 Z"></path>
      <path d="M108 119 C 110 125, 114.6 131, 113.2 139 a 3.2 3.2 0 1 0 5.6 0 C 117.4 131, 122 125, 124 119 Z"></path>
      <path d="M128 116 C 130 122, 134.6 137, 133.4 145 a 3.0 3.0 0 1 0 5.2 0 C 137.4 137, 142 122, 144 116 Z"></path>
    </g>

    <!-- The flesh: a lump bulging up on the left and tapering to a point on the right. -->
    <path
      d="M20 112 C 6 78, 28 28, 82 22 C 132 16, 174 42, 194 92 C 182 106, 162 114, 140 118 C 100 124, 52 125, 30 121 C 24 119, 21 116, 20 112 Z"
      style="fill: url(#surreal-eye-flesh)"></path>

    <!-- The fold of the heavy upper lid. -->
    <path
      d="M22 102 C 30 50, 118 32, 180 84"
      fill="none"
      style="stroke: var(--dream-flesh-dark)"
      stroke-width="3"
      stroke-linecap="round"
      opacity="0.5"></path>

    <!-- The opening; it squeezes shut when the eye blinks. -->
    <g class="eye-lid">
      <path d="M22 110 C 30 62, 112 46, 170 90 C 148 116, 70 128, 22 110 Z" style="fill: var(--dream-sclera)"></path>
      <g clip-path="url(#surreal-eye-opening)">
        <g data-eye-iris>
          <circle cx="92" cy="94" r="31" style="fill: url(#surreal-eye-iris)"></circle>
          <circle cx="92" cy="94" r="12" style="fill: var(--dream-pupil)"></circle>
          <!-- The crescent of light along the iris's lower left. -->
          <path
            d="M70 82 C 64 100, 74 116, 92 119 C 79 111, 71 98, 75 82 Z"
            style="fill: var(--dream-sclera)"
            opacity="0.9"></path>
        </g>
        <rect x="0" y="40" width="200" height="90" style="fill: url(#surreal-eye-lid-shadow)"></rect>
      </g>
      <path
        d="M22 110 C 30 62, 112 46, 170 90 C 148 116, 70 128, 22 110 Z"
        fill="none"
        style="stroke: var(--dream-flesh-dark)"
        stroke-width="2.5"
        stroke-linejoin="round"></path>
    </g>
  </g>
</svg>

<script>
  // How far the iris may travel from center, in SVG units (the opening is wide and shallow).
  const REACH_X = 18;
  const REACH_Y = 5;

  function initEyes() {
    const eyes = [...document.querySelectorAll<SVGSVGElement>('[data-surreal-eye]')];
    if (!eyes.length) return;

    let pointerX = 0;
    let pointerY = 0;
    let frame = 0;

    const look = () => {
      frame = 0;
      for (const eye of eyes) {
        const iris = eye.querySelector<SVGGElement>('[data-eye-iris]');
        if (!iris) continue;
        const box = eye.getBoundingClientRect();
        const dx = pointerX - (box.left + box.width / 2);
        const dy = pointerY - (box.top + box.height / 2);
        const distance = Math.hypot(dx, dy) || 1;
        // Ease in over the first ~300px so the pupil doesn't snap to the rim when you're close.
        const strength = Math.min(1, distance / 300);
        const x = (dx / distance) * REACH_X * strength;
        const y = (dy / distance) * REACH_Y * strength;
        iris.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
      }
    };

    window.addEventListener(
      'pointermove',
      (event) => {
        pointerX = event.clientX;
        pointerY = event.clientY;
        if (!frame) frame = requestAnimationFrame(look);
      },
      { passive: true }
    );
  }

  initEyes();
</script>
