---
// A floating eye after Magritte's "The False Mirror": a sky with clouds in the iris, a pupil
// that follows the pointer, and the occasional blink. Sized in em, so it scales with the
// heading it sits in. Purely decorative.
---

<svg class="surreal-eye hide-in-signal" viewBox="0 0 200 124" aria-hidden="true" focusable="false" data-surreal-eye>
  <defs>
    <clipPath id="surreal-eye-clip">
      <path d="M8 66 C 52 10, 148 10, 192 66 C 148 118, 52 118, 8 66 Z"></path>
    </clipPath>
    <radialGradient id="surreal-eye-iris" cx="50%" cy="42%" r="62%">
      <stop offset="0" style="stop-color: var(--dream-iris)"></stop>
      <stop offset="0.72" style="stop-color: var(--dream-iris)"></stop>
      <stop offset="1" style="stop-color: var(--dream-iris-edge)"></stop>
    </radialGradient>
  </defs>

  <g class="eye-lid">
    <path d="M8 66 C 52 10, 148 10, 192 66 C 148 118, 52 118, 8 66 Z" style="fill: var(--dream-sclera)"></path>

    <g clip-path="url(#surreal-eye-clip)">
      <g data-eye-iris>
        <circle cx="100" cy="66" r="38" style="fill: url(#surreal-eye-iris)"></circle>
        <use href="#dream-cloud-shape" x="66" y="42" width="40" height="17" style="color: var(--dream-sclera)"></use>
        <use href="#dream-cloud-shape" x="98" y="74" width="30" height="13" style="color: var(--dream-sclera)"></use>
        <circle cx="100" cy="66" r="14" style="fill: var(--dream-pupil)"></circle>
        <circle cx="93" cy="59" r="4.5" fill="#ffffff" opacity="0.85"></circle>
      </g>
    </g>

    <path
      d="M8 66 C 52 10, 148 10, 192 66 C 148 118, 52 118, 8 66 Z"
      fill="none"
      style="stroke: var(--dream-eye-line)"
      stroke-width="3.5"
      stroke-linejoin="round"></path>

    <g style="stroke: var(--color-slate-100)" stroke-width="3.5" stroke-linecap="round" fill="none">
      <path d="M40 38 L30 24"></path>
      <path d="M68 25 L63 10"></path>
      <path d="M100 21 L100 5"></path>
      <path d="M132 25 L137 10"></path>
      <path d="M160 38 L170 24"></path>
    </g>
  </g>
</svg>

<script>
  // How far the iris may travel from center, in SVG units (the eye is wider than tall).
  const REACH_X = 26;
  const REACH_Y = 14;

  function initEyes() {
    const eyes = [...document.querySelectorAll<SVGSVGElement>('[data-surreal-eye]')];
    if (!eyes.length) return;

    let pointerX = 0;
    let pointerY = 0;
    let frame = 0;

    const look = () => {
      frame = 0;
      for (const eye of eyes) {
        const iris = eye.querySelector<SVGGElement>('[data-eye-iris]');
        if (!iris) continue;
        const box = eye.getBoundingClientRect();
        const dx = pointerX - (box.left + box.width / 2);
        const dy = pointerY - (box.top + box.height / 2);
        const distance = Math.hypot(dx, dy) || 1;
        // Ease in over the first ~300px so the pupil doesn't snap to the rim when you're close.
        const strength = Math.min(1, distance / 300);
        const x = (dx / distance) * REACH_X * strength;
        const y = (dy / distance) * REACH_Y * strength;
        iris.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
      }
    };

    window.addEventListener(
      'pointermove',
      (event) => {
        pointerX = event.clientX;
        pointerY = event.clientY;
        if (!frame) frame = requestAnimationFrame(look);
      },
      { passive: true }
    );
  }

  initEyes();
</script>
