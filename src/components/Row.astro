---
// One line of a list: a title, an optional subtitle and a right-aligned note. Anything passed as
// children folds away behind a plus sign, so the page stays bare until someone asks for more.
interface Props {
  title: string;
  subtitle?: string;
  meta?: string;
  id?: string;
  /** Start unfolded. */
  open?: boolean;
}

const { title, subtitle, meta, id, open = false } = Astro.props;
---

<details id={id} class="row" open={open}>
  <summary class="row-head">
    <span class="row-heading">
      <h3 class="row-title">{title}</h3>
      {subtitle && <span class="row-subtitle">{subtitle}</span>}
    </span>
    {meta && <span class="row-meta">{meta}</span>}
    <span class="row-toggle" aria-hidden="true"></span>
  </summary>
  <div class="row-body">
    <slot />
  </div>
</details>
