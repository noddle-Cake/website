---
import ProjectGlyph from './ProjectGlyph.astro';

interface Props {
  /** Content id — picks the silhouette shown in the minimal look. */
  id: string;
  code?: string;
  title: string;
  stack: string[];
  summary: string;
  github?: string;
  demo?: string;
}

const { id, code, title, stack, summary, github, demo } = Astro.props;
// Demos on other sites open in a new tab; on-site demos (e.g. /vas-demo) stay in this one.
const demoIsExternal = demo?.startsWith('http');
---

<div
  data-reveal
  class="dream-card group border border-slate-800 p-5 hover:border-slate-500 hover:-translate-y-1"
>
  <div class="project-glyph only-minimal">
    <ProjectGlyph name={id} />
  </div>
  {code && <p class="project-code only-minimal">{code}</p>}
  <div class="project-head flex items-start justify-between gap-3">
    <h3 class="font-semibold text-slate-100 group-hover:text-slate-50 transition-colors">{title}</h3>
    <div class="project-links flex items-center gap-3 shrink-0">
      {demo && (
        <a
          href={demo}
          target={demoIsExternal ? '_blank' : undefined}
          rel={demoIsExternal ? 'noopener noreferrer' : undefined}
          class="text-xs text-slate-900 bg-slate-100 hover:bg-slate-300 rounded px-2 py-1 font-medium transition-colors"
        >
          Live demo &rarr;
        </a>
      )}
      {github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-slate-400 hover:text-slate-100 transition-colors"
        >
          GitHub &rarr;
        </a>
      )}
    </div>
  </div>
  <p class="project-summary text-sm text-slate-400 mt-2 leading-relaxed">{summary}</p>
  <div class="project-stack flex flex-wrap gap-2 mt-4">
    {stack.map((tech) => (
      <span class="text-xs bg-slate-800 text-slate-300 rounded px-2 py-1 transition-colors group-hover:bg-slate-700">
        {tech}
      </span>
    ))}
  </div>
</div>
