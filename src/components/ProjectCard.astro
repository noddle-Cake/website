---
interface Props {
  title: string;
  stack: string[];
  summary: string;
  github?: string;
  demo?: string;
}

const { title, stack, summary, github, demo } = Astro.props;
---

<div
  data-reveal
  class="group border border-slate-800 rounded-lg p-5 transition-all duration-300 hover:border-slate-500 hover:-translate-y-1 hover:shadow-lg"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-semibold text-slate-100 group-hover:text-slate-50 transition-colors">{title}</h3>
    <div class="flex items-center gap-3 shrink-0">
      {demo && (
        <a
          href={demo}
          class="text-xs text-slate-900 bg-slate-100 hover:bg-slate-300 rounded px-2 py-1 font-medium transition-colors"
        >
          Live demo &rarr;
        </a>
      )}
      {github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-slate-400 hover:text-slate-100 transition-colors"
        >
          GitHub &rarr;
        </a>
      )}
    </div>
  </div>
  <p class="text-sm text-slate-400 mt-2 leading-relaxed">{summary}</p>
  <div class="flex flex-wrap gap-2 mt-4">
    {stack.map((tech) => (
      <span class="text-xs bg-slate-800 text-slate-300 rounded px-2 py-1 transition-colors group-hover:bg-slate-700">
        {tech}
      </span>
    ))}
  </div>
</div>
