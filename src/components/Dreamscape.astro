---
// Decorative backdrop behind every page: a dripping painted sun at the top of the page and painted
// clouds drifting across the screen. They are the only imagery in the site's look.
import sun from '../assets/dream/sun.webp';
import cloud1 from '../assets/dream/cloud-1.webp';
import cloud2 from '../assets/dream/cloud-2.webp';
import cloud3 from '../assets/dream/cloud-3.webp';

interface Props {
  /** Drop the backdrop entirely, for pages meant for focused reading. */
  quiet?: boolean;
}

const { quiet = false } = Astro.props;

// Negative delays start each cloud mid-journey so the sky isn't empty on load.
const clouds = [
  { image: cloud1, top: '13vh', width: 'clamp(11rem, 26vw, 22rem)', duration: '150s', delay: '-40s' },
  { image: cloud2, top: '34vh', width: 'clamp(8rem, 17vw, 14rem)', duration: '210s', delay: '-150s' },
  { image: cloud3, top: '5vh', width: 'clamp(7rem, 14vw, 12rem)', duration: '180s', delay: '-110s' },
];
---

{
  !quiet && (
    <>
      <img class="dream-sun" src={sun.src} width={sun.width} height={sun.height} alt="" decoding="async" />
      <div class="dreamscape" aria-hidden="true">
        {clouds.map((c) => (
          <img
            class="dream-cloud"
            src={c.image.src}
            width={c.image.width}
            height={c.image.height}
            alt=""
            decoding="async"
            style={`--top: ${c.top}; --width: ${c.width}; --duration: ${c.duration}; --delay: ${c.delay}`}
          />
        ))}
      </div>
    </>
  )
}
