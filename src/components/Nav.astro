---
import { profile } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-50 border-b border-slate-800 bg-slate-950/80 backdrop-blur">
  <nav class="w-full max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="font-mono font-semibold tracking-tight text-slate-100 hover:text-slate-300 transition-colors">
      cjservin<span class="text-accent">.</span><span class="signal-cursor signal-only text-slate-400">_</span>
    </a>
    <div class="flex items-center gap-3 sm:gap-6 text-sm text-slate-400">
      <a href="/#about" class="hover:text-slate-100 transition-colors">About</a>
      <a href="/projects" class="hover:text-slate-100 transition-colors">Projects</a>
      <a href="/#contact" class="hidden sm:inline hover:text-slate-100 transition-colors">Contact</a>
      <ThemeToggle />
    </div>
  </nav>
</header>
