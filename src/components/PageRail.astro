---
// The blueprint look's page ruler (inspired by getartcraft.com/apps): a tape of tick marks down
// the right edge measuring the whole page from 0 to 100%, a marker reading where you are, and the
// name of each [data-rail] section riding the ruler. As a section reaches the top, its letters fly
// up into a big title in the top-right corner; sections still below the fold queue up bottom-right.
// Click or drag the ruler to jump. Styles live in styles/look-blueprint.css; hidden in other looks.
const ticks = Array.from({ length: 101 }, (_, i) => i);
---

<div class="page-rail only-blueprint" data-page-rail>
  <div class="rail-corner rail-corner-top" aria-hidden="true"></div>
  <div class="rail-corner rail-corner-bottom" aria-hidden="true" data-rail-queue-backdrop></div>
  <div
    class="rail-track"
    role="scrollbar"
    aria-controls="main"
    aria-orientation="vertical"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    aria-label="Page position"
    data-rail-track
  >
    <div class="rail-backdrop" aria-hidden="true"></div>
    <div class="rail-tape" aria-hidden="true" data-rail-tape>
      {
        ticks.map((i) => (
          <div class:list={['rail-tick', { 'is-major': i % 5 === 0 }]} style={`top: ${i}%`}>
            {i % 5 === 0 && <span>{i}</span>}
          </div>
        ))
      }
    </div>
    <div class="rail-hover" aria-hidden="true" data-rail-hover></div>
    <div class="rail-marker" aria-hidden="true" data-rail-marker>
      <span data-rail-percent>000%</span>
    </div>
  </div>
  <div class="rail-titles" aria-hidden="true" data-rail-titles></div>
</div>

<script>
  /** Fixed size the title letters are set at; every state is a scale of it. */
  const BASE_PX = 34;
  /** Width of the ruler strip (matches --bp-rail in look-blueprint.css). */
  const RAIL_PX = 60;

  interface Letter {
    el: HTMLSpanElement;
    /** Center of the letter from the start of the word, at BASE_PX. */
    center: number;
  }

  interface Section {
    el: HTMLElement;
    letters: Letter[];
    /** Word width at BASE_PX. */
    width: number;
    /** Document y of the section's top edge. */
    top: number;
  }

  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const ease = (t: number) => t * t * (3 - 2 * t);

  function initPageRail() {
    const rail = document.querySelector<HTMLElement>('[data-page-rail]');
    if (!rail || rail.dataset.ready) return;
    rail.dataset.ready = 'true';

    const track = rail.querySelector<HTMLElement>('[data-rail-track]')!;
    const tape = rail.querySelector<HTMLElement>('[data-rail-tape]')!;
    const marker = rail.querySelector<HTMLElement>('[data-rail-marker]')!;
    const percent = rail.querySelector<HTMLElement>('[data-rail-percent]')!;
    const hover = rail.querySelector<HTMLElement>('[data-rail-hover]')!;
    const titles = rail.querySelector<HTMLElement>('[data-rail-titles]')!;
    const queueBackdrop = rail.querySelector<HTMLElement>('[data-rail-queue-backdrop]')!;
    const wide = window.matchMedia('(min-width: 64rem)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const sections: Section[] = [...document.querySelectorAll<HTMLElement>('[data-rail]')].map((el) => {
      const word = (el.dataset.rail ?? '').toUpperCase();
      const letters = [...word].map((char) => {
        const span = document.createElement('span');
        span.className = 'rail-letter';
        span.textContent = char === ' ' ? ' ' : char;
        titles.append(span);
        return { el: span, center: 0 };
      });
      return { el, letters, width: 0, top: 0 };
    });

    const isActive = () => document.documentElement.dataset.look === 'blueprint' && wide.matches;

    // Lay each word out once in the title font to learn where its letters sit.
    function measure() {
      const probe = document.createElement('span');
      probe.className = 'rail-letter rail-probe';
      titles.append(probe);
      for (const section of sections) {
        probe.replaceChildren(
          ...section.letters.map((l) => {
            const s = document.createElement('span');
            s.textContent = l.el.textContent;
            return s;
          }),
        );
        const start = probe.getBoundingClientRect().left;
        [...probe.children].forEach((child, i) => {
          const r = child.getBoundingClientRect();
          section.letters[i].center = r.left - start + r.width / 2;
        });
        section.width = probe.getBoundingClientRect().width;
      }
      probe.remove();
    }

    function layout() {
      if (!isActive()) return;
      // Keep the frost and clipping boundary below the real bars, including wrapped labels.
      const root = document.documentElement;
      const headerHeight = document.querySelector('header')!.getBoundingClientRect().height;
      const barHeight = document.querySelector('.hero-label, .section-label')?.getBoundingClientRect().height ?? 48;
      root.style.setProperty('--bp-header-offset', `${headerHeight}px`);
      root.style.setProperty('--bp-section-bar', `${barHeight}px`);
      measure();
      for (const section of sections) {
        section.top = section.el.getBoundingClientRect().top + window.scrollY;
      }
      update();
    }

    function update() {
      if (!isActive()) return;
      const vh = window.innerHeight;
      const vw = document.documentElement.clientWidth;
      const maxScroll = Math.max(1, document.documentElement.scrollHeight - vh);
      const y = window.scrollY;
      const progress = clamp01(y / maxScroll);

      // The tape is the whole page scaled to the ruler (which starts below the header), sliding
      // so the tick for p% always sits p% of the way down the ruler, right under the marker.
      const rulerH = track.clientHeight;
      const tapeH = document.documentElement.scrollHeight * (rulerH / vh);
      tape.style.height = `${tapeH}px`;
      tape.style.transform = `translate3d(0, ${-progress * (tapeH - rulerH)}px, 0)`;
      marker.style.transform = `translate3d(0, ${progress * rulerH}px, 0)`;
      const pct = Math.round(progress * 100);
      percent.textContent = `${String(pct).padStart(3, '0')}%`;
      track.setAttribute('aria-valuenow', String(pct));

      const titleRight = vw - RAIL_PX - 28;
      const header = document.querySelector('header')!.getBoundingClientRect().height;
      const sectionBar = document.querySelector('.hero-label, .section-label')?.getBoundingClientRect().height ?? 48;
      const snap = reducedMotion.matches;

      // f: how far each section has flown from the ruler into the title (1 = it's the title).
      // A section near the bottom of the page may never reach the top, so it finishes early.
      const flown = sections.map((s) => {
        const top = s.top - y;
        const end = Math.max(vh * 0.22, s.top - maxScroll);
        const start = end + vh * 0.3;
        const t = clamp01((start - top) / (start - end));
        return snap ? Math.round(t) : t;
      });
      // g: how far each section has come out of the bottom-right queue onto the ruler.
      const arrived = sections.map((s) => {
        const top = s.top - y;
        const t = clamp01((vh + 40 - top) / 160);
        return snap ? Math.round(t) : t;
      });

      // The bottom frost is only there for the queue; once it's empty, the footer shows clearly.
      queueBackdrop.style.opacity = String(clamp01(arrived.reduce((sum, a) => sum + (1 - a), 0)));

      sections.forEach((section, k) => {
        const top = section.top - y;
        const g = arrived[k];
        const f = flown[k];
        const demoted = flown[k + 1] ?? 0; // the next section has taken the title
        const gone = flown[k + 2] ?? 0; // and the one after that, too
        // Queue slot: sections still waiting stack upward from the bottom, nearest on top.
        const waitingBelow = arrived.slice(k + 1).reduce((sum, a) => sum + (1 - a), 0);
        const n = section.letters.length;

        section.letters.forEach((letter, i) => {
          // Letters leave one after another, so the word peels off the ruler.
          const stagger = 0.45;
          const fi = ease(clamp01(f * (1 + stagger) - (i / Math.max(1, n - 1)) * stagger));
          const di = ease(demoted);

          // Queue: small, right-aligned, bottom-right.
          const qs = 0.42;
          let x = titleRight - section.width * qs + letter.center * qs;
          let ly = vh - 40 - waitingBelow * 22;
          let rot = 0;
          let scale = qs;
          let ink = 0.35;

          // Ruler: rotated to read bottom-to-top, the word hanging below the section's top edge.
          const rs = 0.55;
          const rx = vw - RAIL_PX - 14;
          const ry = top + (section.width - letter.center) * rs + 8;
          x = lerp(x, rx, g);
          ly = lerp(ly, ry, g);
          rot = lerp(rot, -90, g);
          scale = lerp(scale, rs, g);

          // Title: full size in the top-right, arcing up on the way there.
          const tx = titleRight - section.width + letter.center;
          const ty = header + sectionBar + 42;
          x = lerp(x, tx, fi);
          ly = lerp(ly, ty, fi) - Math.sin(Math.PI * fi) * 40;
          rot = lerp(rot, 0, fi);
          scale = lerp(scale, 1, fi);
          ink = lerp(ink, 1, fi);

          // Previous title: shrinks into a faint line above the new one.
          const ps = 0.47;
          x = lerp(x, titleRight - section.width * ps + letter.center * ps, di);
          ly = lerp(ly, header + sectionBar + 14, di);
          scale = lerp(scale, ps, di);
          ink = lerp(ink, 0.35, di);

          letter.el.style.transform = `translate3d(${x}px, ${ly}px, 0) translate(-50%, -50%) rotate(${rot}deg) scale(${scale})`;
          letter.el.style.opacity = String(1 - gone);
          letter.el.style.setProperty('--ink', `${Math.round(ink * 100)}%`);
        });
      });
    }

    // ---- Seek by clicking or dragging the ruler ----
    function seek(clientY: number) {
      const box = track.getBoundingClientRect();
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      window.scrollTo({ top: clamp01((clientY - box.top) / box.height) * maxScroll, behavior: 'instant' });
    }

    track.addEventListener('pointerdown', (e) => {
      track.setPointerCapture(e.pointerId);
      seek(e.clientY);
    });
    track.addEventListener('pointermove', (e) => {
      hover.style.opacity = '1';
      hover.style.transform = `translate3d(0, ${e.clientY - track.getBoundingClientRect().top}px, 0)`;
      if (track.hasPointerCapture(e.pointerId)) seek(e.clientY);
    });
    track.addEventListener('pointerleave', () => {
      hover.style.opacity = '0';
    });

    let frame = 0;
    const schedule = (fn: () => void) => () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(fn);
    };
    const scheduleUpdate = schedule(update);
    const scheduleLayout = schedule(layout);

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleLayout);
    wide.addEventListener('change', scheduleLayout);
    new ResizeObserver(scheduleLayout).observe(document.body);
    // Re-measure when the look changes (the title font only applies in blueprint) and once fonts land.
    new MutationObserver(scheduleLayout).observe(document.documentElement, { attributeFilter: ['data-look'] });
    document.fonts.ready.then(scheduleLayout);
    layout();
  }

  initPageRail();
  document.addEventListener('astro:after-swap', initPageRail);
</script>
