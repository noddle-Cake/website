---
import { profile } from '../data/profile';
import SignalToggle from './SignalToggle.astro';
---

<footer id="contact" class="border-t border-slate-800 mt-24">
  <div class="w-full max-w-5xl mx-auto px-6 py-16">
    <p
      data-reveal
      class="text-[clamp(1.75rem,5vw,3.5rem)] font-extrabold tracking-tight leading-[1.05] max-w-3xl"
    >
      Let&rsquo;s build something that actually works.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-sm text-slate-400">
      <div class="flex flex-wrap gap-4 sm:gap-6">
        <a href={`mailto:${profile.email}`} class="hover:text-slate-100 transition-colors">
          {profile.email}
        </a>
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-slate-100 transition-colors">
          LinkedIn
        </a>
      </div>
      <div class="flex items-center gap-4">
        <p>&copy; {new Date().getFullYear()} {profile.name}</p>
        <SignalToggle />
      </div>
    </div>
  </div>
</footer>
