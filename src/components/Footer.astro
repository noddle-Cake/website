---
import { profile } from '../data/profile';
import SignalToggle from './SignalToggle.astro';
import PalettePicker from './PalettePicker.astro';
import LookToggle from './LookToggle.astro';
---

<footer id="contact" class="border-t border-slate-800 mt-24 bg-slate-950/70 backdrop-blur-sm">
  <div class="w-full max-w-5xl mx-auto px-6 py-16">
    <p
      data-reveal
      class="footer-statement font-display text-[clamp(1.75rem,5vw,3.5rem)] font-extrabold tracking-tight leading-[1.05] max-w-3xl"
    >
      Let&rsquo;s build something that <em class="text-accent">actually works.</em>
    </p>
    <div class="footer-row mt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-sm text-slate-400">
      <div class="flex flex-wrap gap-4 sm:gap-6">
        <a href={`mailto:${profile.email}`} class="hover:text-slate-100 transition-colors">
          {profile.email}
        </a>
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-slate-100 transition-colors">
          LinkedIn
        </a>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <p>&copy; {new Date().getFullYear()} {profile.name}</p>
        <LookToggle />
        <PalettePicker />
        <SignalToggle />
      </div>
    </div>
  </div>
  <div class="dream-piazza hide-in-signal" aria-hidden="true">
    <div class="dream-floor"></div>
    <div class="dream-horizon"></div>
    <div class="dream-ball-shadow"></div>
    <div class="dream-ball"></div>
  </div>
</footer>
