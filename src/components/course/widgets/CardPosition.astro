<div
  data-widget="card-position"
  data-reveal
  class="not-prose border border-slate-800 rounded-lg p-5 my-8 bg-slate-900/30"
>
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500 mb-4">
    Interactive &middot; Where the j-th special card lands
  </p>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-5">
    <label class="block text-sm">
      <span class="text-slate-300">Deck size N = <span data-out="N" class="font-mono text-slate-100"></span></span>
      <input data-slider="N" type="range" min="4" max="52" step="1" value="52" class="w-full accent-slate-300 mt-1" />
    </label>
    <label class="block text-sm">
      <span class="text-slate-300">Special cards S = <span data-out="S" class="font-mono text-slate-100"></span></span>
      <input data-slider="S" type="range" min="1" max="52" step="1" value="13" class="w-full accent-slate-300 mt-1" />
    </label>
    <label class="block text-sm">
      <span class="text-slate-300">Occurrence j = <span data-out="j" class="font-mono text-slate-100"></span></span>
      <input data-slider="j" type="range" min="1" max="13" step="1" value="1" class="w-full accent-slate-300 mt-1" />
    </label>
    <label class="block text-sm">
      <span class="text-slate-300">Position p = <span data-out="p" class="font-mono text-slate-100"></span></span>
      <input data-slider="p" type="range" min="1" max="52" step="1" value="4" class="w-full accent-slate-300 mt-1" />
    </label>
  </div>

  <div class="overflow-x-auto">
    <canvas class="border border-slate-800 rounded"></canvas>
  </div>

  <p data-out="formula" class="mt-3 font-mono text-xs text-slate-400"></p>
  <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-xs font-mono">
    <dt class="text-slate-500">P(j-th special at p)</dt>
    <dd class="text-slate-100"><span data-out="probDec"></span> &nbsp;(<span data-out="prob"></span>)</dd>
    <dt class="text-slate-500">P(at position &le; p)</dt>
    <dd data-out="cum" class="text-slate-100"></dd>
  </dl>
  <p class="mt-3 text-xs text-slate-500 leading-relaxed">
    Defaults are the standard question: a 52-card deck, 13 spades, and the <em>first</em> spade landing
    on the 4th card. Set S = 4 and j = 3 for the king version.
  </p>
</div>

<script>
  import '../../../scripts/courses/widgets/card-position';
</script>
