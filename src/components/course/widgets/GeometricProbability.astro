<div
  data-widget="geometric-probability"
  data-reveal
  class="not-prose border border-slate-800 rounded-lg p-5 my-8 bg-slate-900/30"
>
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500 mb-4">
    Interactive &middot; Probability as area
  </p>

  <div class="flex flex-col lg:flex-row gap-6">
    <canvas class="border border-slate-800 rounded shrink-0 max-w-full"></canvas>

    <div class="flex-1 min-w-0">
      <label class="block text-sm">
        <span class="text-slate-300">Event</span>
        <select
          data-region
          class="w-full mt-1 bg-slate-900 border border-slate-800 rounded px-2 py-1.5 text-sm text-slate-100"
        >
          <option value="above-abs">y &gt; |x|</option>
          <option value="above-diag">y &gt; x</option>
          <option value="band">|y &minus; 2x| &le; &epsilon;</option>
          <option value="disc">x&sup2; + y&sup2; &lt; 1</option>
          <option value="diamond">|x| + |y| &lt; 1</option>
        </select>
      </label>

      <label class="block text-sm mt-4">
        <span class="text-slate-300"
          >Band half-width &epsilon; = <span data-eps-readout class="font-mono"></span></span
        >
        <input
          data-slider="eps"
          type="range"
          min="0"
          max="500"
          step="1"
          value="150"
          class="w-full accent-slate-300 mt-1"
        />
        <span class="block text-xs text-slate-500 mt-1"
          >Only affects the band event. Drag it to 0 to collapse the strip onto the bare line.</span
        >
      </label>

      <div class="mt-4 flex gap-2">
        <button
          type="button"
          data-throw
          class="text-xs border border-slate-800 rounded px-3 py-1.5 text-slate-300 hover:border-slate-500 transition-colors"
        >
          Throw 400 darts
        </button>
        <button
          type="button"
          data-reset
          class="text-xs border border-slate-800 rounded px-3 py-1.5 text-slate-500 hover:border-slate-500 transition-colors"
        >
          Reset
        </button>
      </div>

      <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-xs font-mono">
        <dt class="text-slate-500">exact</dt>
        <dd data-exact class="text-slate-100"></dd>
        <dt class="text-slate-500">darts</dt>
        <dd data-empirical class="text-slate-100"></dd>
      </dl>
      <p data-formula class="mt-2 text-xs text-slate-400 leading-relaxed"></p>
    </div>
  </div>
</div>

<script>
  import '../../../scripts/courses/widgets/geometric-probability';
</script>
