---
import Math from '../Math.astro';
---

<div
  data-widget="quantization"
  data-reveal
  class="not-prose border border-slate-800 rounded-lg p-5 my-8 bg-slate-900/30"
>
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500 mb-4">Interactive &middot; Quantization</p>
  <div class="flex flex-col sm:flex-row gap-6 items-center">
    <canvas class="border border-slate-800 rounded shrink-0"></canvas>
    <div class="flex-1 w-full">
      <label class="block text-sm text-slate-300 mb-2" for="bits-slider">Bits per pixel</label>
      <input id="bits-slider" type="range" min="1" max="8" step="1" value="8" class="w-full accent-slate-300" />
      <p data-readout class="mt-3 text-sm font-mono text-slate-400"></p>
      <p class="mt-3 text-sm text-slate-400 leading-relaxed">
        Drag the slider down and watch the smooth sphere collapse into visible bands — each band is one of the
        <Math tex="2^{\text{bits}}" />
        gray levels quantization allows.
      </p>
    </div>
  </div>
</div>

<script>
  import '../../../scripts/courses/widgets/quantization';
</script>
