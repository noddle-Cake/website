---
interface Props {
  label?: string;
  variant?: 'note' | 'intuition' | 'warning';
}

const { label, variant = 'note' } = Astro.props;

const defaultLabel = {
  note: 'Note',
  intuition: 'Intuition',
  warning: 'Watch out',
}[variant];
---

<div
  data-reveal
  class:list={[
    'border-l-2 rounded-r-lg px-4 py-3 my-6 text-sm leading-relaxed',
    variant === 'intuition' && 'border-slate-500 bg-slate-900/60 text-slate-300',
    variant === 'warning' && 'border-slate-400 bg-slate-900/60 text-slate-300',
    variant === 'note' && 'border-slate-700 bg-slate-900/40 text-slate-400',
  ]}
>
  <p class="font-mono text-xs uppercase tracking-[0.15em] text-slate-500 mb-1.5">
    {label ?? defaultLabel}
  </p>
  <div class="prose-course">
    <slot />
  </div>
</div>
