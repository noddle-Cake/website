---
interface Props {
  title: string;
  summary: string;
  status: 'planned' | 'in-progress' | 'live';
  href?: string;
}

const { title, summary, status, href } = Astro.props;

const statusLabel = {
  planned: 'Planned',
  'in-progress': 'In progress',
  live: 'Live',
}[status];

const isLive = status === 'live' && href;
const Tag = isLive ? 'a' : 'div';
---

<Tag
  data-reveal
  href={isLive ? href : undefined}
  class="group block border border-slate-800 rounded-lg p-5 transition-all duration-300 hover:border-slate-500 hover:-translate-y-1 hover:shadow-lg"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-semibold text-slate-100 group-hover:text-slate-50 transition-colors">{title}</h3>
    <span
      class:list={[
        'text-xs rounded px-2 py-1 font-medium shrink-0',
        status === 'live'
          ? 'text-slate-900 bg-slate-100'
          : 'text-slate-400 bg-slate-800',
      ]}
    >
      {statusLabel}
    </span>
  </div>
  <p class="text-sm text-slate-400 mt-2 leading-relaxed">{summary}</p>
</Tag>
